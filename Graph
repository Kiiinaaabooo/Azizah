/ Graph class managing nodes and edges
class Graph {
    private ArrayList<Node> nodes;
    private ArrayList<Edge> edges;
    private int[][] adjacencyMatrix;
    private String[] labels;

    public Graph(int[][] adjacencyMatrix, String[] labels) {
        this.adjacencyMatrix = adjacencyMatrix;
        this.labels = labels;
        this.nodes = new ArrayList<>();
        this.edges = new ArrayList<>();
        initializeGraph();
    }

    private void initializeGraph() {
        int n = adjacencyMatrix.length;

        // Create nodes with custom positions matching the image layout
        int[][] positions = {
            {150, 300},   // MKS (0)
            {300, 200},   // SUB (1)
            {450, 200},   // DPS (2)
            {600, 250},   // YOG (3)
            {300, 400},   // CGK (4)
            {450, 450},   // DHS (5)
            {650, 450},   // BTM (6)
            {300, 600},   // BDG (7)
            {500, 600},   // MLG (8)
            {650, 650}    // PDG (9)
        };

        for (int i = 0; i < n; i++) {
            nodes.add(new Node(i, positions[i][0], positions[i][1]));
        }

        // Create edges from adjacency matrix
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (adjacencyMatrix[i][j] != 0) {
                    edges.add(new Edge(nodes.get(i), nodes.get(j), adjacencyMatrix[i][j]));
                }
            }
        }
    }

    public ArrayList<Node> getNodes() { return nodes; }
    public ArrayList<Edge> getEdges() { return edges; }
    public String[] getLabels() { return labels; }
}

